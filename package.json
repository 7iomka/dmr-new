{
  "name": "dmr-angular",
  "version": "0.0.2",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "fix": "pnpm lint:fix && pnpm format",
    "check": "pnpm lint && pnpm format:check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,html,js,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{ts,html,scss,css,js,mjs,cjs,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@angular/animations": "^21.2.5",
    "@angular/cdk": "^21.2.3",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@angular/forms": "^21.2.5",
    "@angular/platform-browser": "^21.2.5",
    "@angular/platform-browser-dynamic": "^21.2.5",
    "@angular/router": "^21.2.5",
    "@lucide/angular": "1.0.0-rc.0",
    "@primeuix/themes": "^2.0.3",
    "@semantic-icons/simple-icons": "^0.58.0",
    "country-flag-emoji-polyfill": "^0.1.8",
    "prettier-plugin-classnames": "^0.9.0",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.3",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "21.3.1",
    "@angular/build": "^21.2.3",
    "@angular/cli": "^21.2.3",
    "@angular/compiler-cli": "^21.2.5",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.10.0",
    "angular-eslint": "21.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.3",
    "postcss-viewport-unit-fallback": "^1.0.1",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "tailwindcss-primeui": "^0.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22 <23"
  }
}
